      "outputs": [],
      "source": [
        "def extract_features_new_api(image_path, detector):\n",
        "    image_bgr = cv2.imread(str(image_path))\n",
        "\n",
        "    if image_bgr is None:\n",
        "        return None\n",
        "\n",
        "    image_rgb = cv2.cvtColor(image_bgr, cv2.COLOR_BGR2RGB)\n",
        "    mp_image = mp.Image(image_format=mp.ImageFormat.SRGB, data=image_rgb)\n",
        "\n",
        "    result = detector.detect(mp_image)\n",
        "\n",
        "    if len(result.pose_landmarks) == 0:\n",
        "        return None\n",
        "\n",
        "    lm = result.pose_landmarks[0]\n",
        "\n",
        "    def p(index):\n",
        "        point = lm[index]\n",
        "        visibility = point.visibility if point.visibility is not None else 0.0\n",
        "        return np.array([point.x, point.y, point.z, visibility], dtype=np.float32)\n",
        "\n",
        "    # MediaPipe Poseのランドマーク番号\n",
        "    # 11: left shoulder, 12: right shoulder\n",
        "    # 23: left hip, 24: right hip\n",
        "    # 25: left knee, 26: right knee\n",
        "    # 27: left ankle, 28: right ankle\n",
        "    # 29: left heel, 30: right heel\n",
        "    # 31: left foot index, 32: right foot index\n",
        "\n",
        "    left_indices = [11, 23, 25, 27, 29, 31]\n",
        "    right_indices = [12, 24, 26, 28, 30, 32]\n",
        "\n",
        "    left_vis = np.mean([p(i)[3] for i in left_indices])\n",
        "    right_vis = np.mean([p(i)[3] for i in right_indices])\n",
        "\n",
        "    if left_vis >= right_vis:\n",
        "        shoulder = p(11)\n",
        "        hip = p(23)\n",
        "        knee = p(25)\n",
        "        ankle = p(27)\n",
        "        heel = p(29)\n",
        "        foot = p(31)\n",
        "    else:\n",
        "        shoulder = p(12)\n",
        "        hip = p(24)\n",
        "        knee = p(26)\n",
        "        ankle = p(28)\n",
        "        heel = p(30)\n",
        "        foot = p(32)\n",
        "\n",
        "    scale = np.linalg.norm(shoulder[:2] - hip[:2])\n",
        "\n",
        "    if scale < 1e-6:\n",
        "        return None\n",
        "\n",
        "    hip_angle = angle_3points(shoulder, hip, knee)\n",
        "    knee_angle = angle_3points(hip, knee, ankle)\n",
        "    ankle_angle = angle_3points(knee, ankle, foot)\n",
        "    torso_lean = angle_with_vertical(shoulder, hip)\n",
        "    shin_lean = angle_with_vertical(knee, ankle)\n",
        "\n",
        "    heel_toe_y = (heel[1] - foot[1]) / scale\n",
        "    knee_toe_x = abs(knee[0] - foot[0]) / scale\n",
        "    ankle_foot_x = abs(ankle[0] - foot[0]) / scale\n",
        "\n",
        "    keypoints = [shoulder, hip, knee, ankle, heel, foot]\n",
        "    coord_features = []\n",
        "\n",
        "    for point in keypoints:\n",
        "        normalized = (point[:3] - hip[:3]) / scale\n",
        "        coord_features.extend(normalized.tolist())\n",
        "        coord_features.append(point[3])\n",
        "\n",
        "    features = coord_features + [\n",
        "        hip_angle,\n",
        "        knee_angle,\n",
        "        ankle_angle,\n",
        "        torso_lean,\n",
        "        shin_lean,\n",
        "        heel_toe_y,\n",
        "        knee_toe_x,\n",
        "        ankle_foot_x\n",
        "    ]\n",
        "\n",
        "    return features"
      ]
    },
