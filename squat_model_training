        "def infer_label(path):\n",
        "    \"\"\"\n",
        "    パス名からラベルを推定する。\n",
        "    フォルダ名が Good, Bad Back, Bad Heel などの場合に対応。\n",
        "    \"\"\"\n",
        "    text = \"/\".join([p.lower().replace(\"_\", \" \").replace(\"-\", \" \") for p in path.parts])\n",
        "\n",
        "    if \"bad back\" in text:\n",
        "        return \"bad_back\"\n",
        "    elif \"bad heel\" in text:\n",
        "        return \"bad_heel\"\n",
        "    elif \"good\" in text:\n",
        "        return \"good\"\n",
        "    else:\n",
        "        return None"
      ]
    },
    {
